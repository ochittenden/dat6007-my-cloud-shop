# Configure in Azure App Service → Environment variables; never commit secrets.
DB_HOST=tcp:your-server.database.windows.net,1433
DB_NAME=cloudcart
DB_USER=your_sql_login
DB_PASSWORD=replace-with-secret
# Optional Google OAuth: register your app's HTTPS redirect URL with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.azurewebsites.net/oauth_google.php
